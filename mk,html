const db = admin.firestore();

/* =========================
   4) Plans + Limits
========================= */
const PLANS = {
  free: { messages: 15, tickets: 5 },
  pro100: { messages: 150, tickets: 40 },
  pro250: { messages: Infinity, tickets: Infinity },
};

function limitValue(v) {
  return v === Infinity ? Number.MAX_SAFE_INTEGER : v;
}

/* =========================
   5) Helpers
========================= */
async function getUser(uid) {
  const ref = db.collection("users").doc(uid);
  const snap = await ref.get();
  return { ref, snap };
}

async function ensureUser(uid, email = null) {
  const { ref, snap } = await getUser(uid);

  if (!snap.exists) {
    await ref.set({
      email: email || "",
      plan: "free",
      messagesUsed: 0,
      ticketsUsed: 0,
      createdAt: admin.firestore.FieldValue.serverTimestamp(),
    });
    return (await ref.get()).data();
  }

  // ضمان وجود حقول لو كانت ناقصة
  const data = snap.data();
  const patch = {};
  if (!("plan" in data)) patch.plan = "free";
  if (!("messagesUsed" in data)) patch.messagesUsed = 0;
  if (!("ticketsUsed" in data)) patch.ticketsUsed = 0;
  if (!("createdAt" in data))
    patch.createdAt = admin.firestore.FieldValue.serverTimestamp();

  if (Object.keys(patch).length) await ref.update(patch);

  return { ...(snap.data() || {}), ...patch };
}

/* =========================
   6) OPTIONAL security:
   تحقق من Firebase ID Token
   (للـ frontend لاحقاً)
========================= */
async function verifyFirebaseToken(req, res, next) {
  try {
    const header = req.headers.authorization || "";
    const token = header.startsWith("Bearer ") ? header.slice(7) : null;

    if (!token) {
      // إذا بدك تخليه إجباري: ارجع 401
      // return res.status(401).json({ error: "Missing Bearer token" });
      req.auth = null;
      return next();
    }

    const decoded = await admin.auth().verifyIdToken(token);
    req.auth = decoded; // { uid, email, ... }
    next();
  } catch (e) {
    return res.status(401).json({ error: "Invalid token" });
  }
}

/* =========================
   7) Limits Middleware
========================= */
async function checkMessageLimit(req, res, next) {
  const uid = req.body.uid || req.auth?.uid;
  if (!uid) return res.status(400).json({ error: "uid required" });

  const user = await ensureUser(uid, req.auth?.email || null);
  const plan = user.plan || "free";
  const limits = PLANS[plan] || PLANS.free;

  if ((user.messagesUsed || 0) >= limitValue(limits.messages)) {
    return res.status(403).json({
      error: "Message limit reached",
      plan,
      messagesUsed: user.messagesUsed || 0,
      messagesLimit: limits.messages,
    });
  }

  req.uid = uid;
  req.user = user;
  next();
}

async function checkTicketLimit(req, res, next) {
  const uid = req.body.uid || req.auth?.uid;
  if (!uid) return res.status(400).json({ error: "uid required" });

  const user = await ensureUser(uid, req.auth?.email || null);
  const plan = user.plan || "free";
  const limits = PLANS[plan] || PLANS.free;

  if ((user.ticketsUsed || 0) >= limitValue(limits.tickets)) {
    return res.status(403).json({
      error: "Ticket limit reached",
      plan,
      ticketsUsed: user.ticketsUsed || 0,
      ticketsLimit: limits.tickets,
    });
  }

  req.uid = uid;
  req.user = user;
  next();
}

